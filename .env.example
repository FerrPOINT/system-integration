# Local development only. Copy to .env and set distinct passwords.
SI_DB_ADMIN_PASSWORD=
SI_DB_PASSWORD=
SI_EMULATOR_DB_PASSWORD=
SI_TEST_DB_PASSWORD=
SI_EMULATOR_TEST_DB_PASSWORD=
# Used only by the explicit demo-users profile. Never enables open registration.
SI_DEMO_PASSWORD=

# Optional PostgreSQL idle-in-transaction protection; active SQL has no blanket timeout.
SI_DB_IDLE_TRANSACTION_TIMEOUT=60s
SI_EMULATOR_DB_IDLE_TRANSACTION_TIMEOUT=60s
