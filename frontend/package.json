{
  "name": "system-integration-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "generate:api": "orval",
    "dev": "orval && vite --host 127.0.0.1 --strictPort",
    "build": "orval && eslint src tests --max-warnings=0 && tsc --noEmit && vite build",
    "test:api": "node --test tests/*.test.mjs",
    "test:assets": "node --test tests/build-assets.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-compose-refs": "1.1.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/eslint-parser": "8.1.2",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "orval": "8.47.0",
    "typescript": "^7.0.2",
    "vite": "8.3.8"
  }
}
