{
  "name": "system-integration-tests",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm typecheck && playwright test",
    "test:components": "pnpm typecheck && pnpm --dir ../frontend typecheck && playwright test --config components.config.ts",
    "test:production": "pnpm typecheck && playwright test --config production.config.ts",
    "test:smoke": "node --test e2e/smoke.test.mjs",
    "test:seed": "node --test ../seed/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "26.6.6",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
